/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Nova использует камеру, когда вы сканируете QR-код настройки Gateway или просите подключенный Gateway либо ассистента снять фото или короткое видео с этого iPhone, например чтобы подключиться к вашему Gateway или показать ассистенту документ, экран устройства или рабочее пространство.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Nova использует ваши контакты, чтобы вы могли искать людей и ссылаться на них при использовании ассистента.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Nova обнаруживает и подключается к вашему Gateway Nova в локальной сети.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Nova может передавать ваше местоположение в фоновом режиме, когда вы включаете «Всегда».";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Nova использует ваше местоположение, когда вы разрешаете передачу местоположения.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Nova использует микрофон для чата в реальном времени, голосовой активации, режима push-to-talk и голосовых заметок.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Nova может использовать данные о движении для поддержки взаимодействий и автоматизаций с учетом устройства.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Nova считывает данные о шагах, сне, пульсе в состоянии покоя и тренировках из приложения Apple Health, чтобы создавать запрошенные вами сводки и отправлять их через ваш Gateway настроенному поставщику ИИ.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Nova не записывает данные в приложение Apple Health. Он использует данные только для чтения, чтобы создавать запрошенные вами сводки и отправлять их через ваш Gateway настроенному поставщику ИИ.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Nova позволяет вашему ассистенту читать разрешённые вами фотографии и позволяет вам выбирать фотографии для отправки.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Nova использует ваши напоминания, чтобы показывать, добавлять и выполнять задачи, когда вы включаете доступ к напоминаниям.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Nova использует распознавание речи на устройстве для режима разговора и голосовой активации.";
