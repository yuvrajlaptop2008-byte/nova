"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Nova usa i tuoi calendari per mostrare eventi e contesto di pianificazione quando abiliti l'accesso al calendario.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Nova usa i tuoi calendari per mostrare eventi e contesto di pianificazione quando abiliti l'accesso al calendario.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Nova usa i tuoi calendari per aggiungere eventi quando abiliti l'accesso al calendario.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Nova usa la fotocamera quando scansioni un codice QR di configurazione del Gateway o chiedi al Gateway associato o all'assistente di acquisire una foto o un breve video da questo iPhone, ad esempio per connetterti al Gateway o mostrare all'assistente un documento, lo schermo di un dispositivo o uno spazio di lavoro.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Nova usa i tuoi contatti per permetterti di cercare e fare riferimento alle persone mentre usi l'assistente.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Nova rileva e si connette al tuo gateway Nova sulla rete locale.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Nova può condividere la tua posizione in background quando abiliti Sempre.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Nova usa la tua posizione quando consenti la condivisione della posizione.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Nova usa il microfono per chat in tempo reale, attivazione vocale, push-to-talk e note vocali.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Nova può usare i dati di movimento per supportare interazioni e automazioni consapevoli del dispositivo.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Nova legge i dati relativi a passi, sonno, frequenza cardiaca a riposo e allenamenti dall'app Salute di Apple per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Nova non scrive nell'app Salute di Apple. Utilizza dati di sola lettura per creare i riepiloghi richiesti e inviarli tramite il tuo Gateway al provider di IA configurato.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Nova consente al tuo assistente di leggere le foto che autorizzi e ti permette di scegliere le foto da condividere.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Nova usa i tuoi promemoria per elencare, aggiungere e completare attività quando abiliti l’accesso ai promemoria.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Nova usa il riconoscimento vocale sul dispositivo per la modalità conversazione e l’attivazione vocale.";
