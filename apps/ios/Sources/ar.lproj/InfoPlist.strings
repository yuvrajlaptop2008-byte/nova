"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "يستخدم Nova تقويماتك لعرض الأحداث وسياق الجدولة عند تفعيل الوصول إلى التقويم.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "يستخدم Nova تقويماتك لعرض الأحداث وسياق الجدولة عند تفعيل الوصول إلى التقويم.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "يستخدم Nova تقويماتك لإضافة أحداث عند تفعيل الوصول إلى التقويم.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "يستخدم Nova الكاميرا عند مسح رمز QR لإعداد Gateway أو عندما تطلب من Gateway المقترن أو المساعد التقاط صورة أو فيديو قصير من هذا iPhone، مثلًا للاتصال بـ Gateway أو لعرض مستند أو شاشة جهاز أو مساحة عمل على مساعدك.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "يستخدم Nova جهات اتصالك حتى تتمكن من البحث عن الأشخاص والإشارة إليهم أثناء استخدام المساعد.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "يكتشف Nova ويتصل ببوابة Nova الخاصة بك على الشبكة المحلية.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "يمكن لـ Nova مشاركة موقعك في الخلفية عند تفعيل دائمًا.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "يستخدم Nova موقعك عندما تسمح بمشاركة الموقع.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "يستخدم Nova الميكروفون للدردشة الفورية، والتنبيه الصوتي، والضغط للتحدث، والملاحظات الصوتية.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "قد يستخدم Nova بيانات الحركة لدعم التفاعلات والأتمتة الواعية بالجهاز.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "يقرأ Nova بيانات خطواتك ونومك ومعدل نبض قلبك أثناء الراحة وتمارينك من تطبيق صحّة Apple لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى مزوّد الذكاء الاصطناعي الذي أعددته.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "لا يكتب Nova أي بيانات إلى تطبيق صحّة Apple. بل يستخدم البيانات المتاحة للقراءة فقط لإنشاء الملخصات التي تطلبها وإرسالها عبر Gateway إلى مزوّد الذكاء الاصطناعي الذي أعددته.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "يتيح Nova لمساعدك قراءة الصور التي تسمح بها، ويتيح لك اختيار الصور لمشاركتها.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "يستخدم Nova تذكيراتك لعرض المهام وإضافتها وإكمالها عند تفعيل الوصول إلى التذكيرات.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "يستخدم Nova التعرف على الكلام على الجهاز لوضع التحدث والتنبيه الصوتي.";
