"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Nova gebruikt je agenda’s om gebeurtenissen en planningscontext te tonen wanneer je agendatoegang inschakelt.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Nova gebruikt je agenda’s om gebeurtenissen en planningscontext te tonen wanneer je agendatoegang inschakelt.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Nova gebruikt je agenda’s om gebeurtenissen toe te voegen wanneer je agendatoegang inschakelt.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Nova gebruikt de camera wanneer je een QR-code voor Gateway-configuratie scant of je gekoppelde Gateway of assistent vraagt om een foto of korte video vanaf deze iPhone vast te leggen, bijvoorbeeld om verbinding te maken met je Gateway of om je assistent een document, apparaatscherm of werkruimte te tonen.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Nova gebruikt je contacten zodat je personen kunt zoeken en vermelden terwijl je de assistent gebruikt.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Nova vindt en maakt verbinding met je Nova-gateway op het lokale netwerk.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Nova kan je locatie op de achtergrond delen wanneer je Altijd inschakelt.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Nova gebruikt je locatie wanneer je locatie delen toestaat.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Nova gebruikt de microfoon voor realtime chat, spraakwake, push-to-talk en spraaknotities.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Nova kan bewegingsgegevens gebruiken ter ondersteuning van apparaatafhankelijke interacties en automatiseringen.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Nova leest je stappen, slaap, rusthartslag en work-outs uit de Apple Gezondheid-app om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Nova schrijft geen gegevens naar de Apple Gezondheid-app. Het gebruikt alleen-lezengegevens om door jou aangevraagde overzichten te maken en deze via je Gateway naar je geconfigureerde AI-provider te verzenden.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Nova laat je assistent foto’s lezen die je toestaat en laat je foto’s kiezen om te delen.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Nova gebruikt je herinneringen om taken weer te geven, toe te voegen en te voltooien wanneer je toegang tot herinneringen inschakelt.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Nova gebruikt spraakherkenning op het apparaat voor de praatmodus en spraakactivering.";
