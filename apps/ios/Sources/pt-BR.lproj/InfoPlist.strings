"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "O Nova usa seus calendários para mostrar eventos e contexto de agendamento quando você ativa o acesso ao calendário.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "O Nova usa seus calendários para mostrar eventos e contexto de agendamento quando você ativa o acesso ao calendário.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "O Nova usa seus calendários para adicionar eventos quando você ativa o acesso ao calendário.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "O Nova usa a câmera quando você escaneia um código QR de configuração do Gateway ou pede ao Gateway pareado ou ao assistente para capturar uma foto ou um vídeo curto deste iPhone, por exemplo, para se conectar ao Gateway ou mostrar ao assistente um documento, a tela de um dispositivo ou seu espaço de trabalho.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "O Nova usa seus contatos para que você possa pesquisar e mencionar pessoas ao usar o assistente.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "O Nova descobre e se conecta ao Gateway do Nova na rede local.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "O Nova pode compartilhar sua localização em segundo plano quando você ativa Sempre.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "O Nova usa sua localização quando você permite o compartilhamento de localização.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "O Nova usa o microfone para chat em tempo real, ativação por voz, pressionar para falar e notas de voz.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "O Nova pode usar dados de movimento para oferecer suporte a interações e automações sensíveis ao dispositivo.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "O Nova lê seus passos, sono, frequência cardíaca em repouso e exercícios no app Saúde da Apple para criar os resumos que você solicitar e enviá-los por meio do seu Gateway para o provedor de IA configurado.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "O Nova não grava dados no app Saúde da Apple. Ele usa dados somente leitura para criar os resumos que você solicitar e enviá-los por meio do seu Gateway para o provedor de IA configurado.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "O Nova permite que seu assistente leia as fotos que você autorizar e permite que você escolha fotos para compartilhar.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "O Nova usa seus lembretes para listar, adicionar e concluir tarefas quando você ativa o acesso aos lembretes.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "O Nova usa reconhecimento de fala no dispositivo para o modo de conversa e ativação por voz.";
