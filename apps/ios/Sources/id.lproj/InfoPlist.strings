"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Nova menggunakan kalender Anda untuk menampilkan acara dan konteks penjadwalan saat Anda mengaktifkan akses kalender.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Nova menggunakan kalender Anda untuk menampilkan acara dan konteks penjadwalan saat Anda mengaktifkan akses kalender.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Nova menggunakan kalender Anda untuk menambahkan acara saat Anda mengaktifkan akses kalender.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Nova menggunakan kamera saat Anda memindai kode QR penyiapan Gateway atau meminta Gateway yang dipasangkan atau asisten Anda untuk mengambil foto atau video pendek dari iPhone ini, misalnya untuk terhubung ke Gateway Anda atau menunjukkan dokumen, layar perangkat, atau ruang kerja kepada asisten Anda.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Nova menggunakan kontak Anda agar Anda dapat mencari dan merujuk orang saat menggunakan asisten.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Nova menemukan dan terhubung ke gateway Nova Anda di jaringan lokal.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Nova dapat membagikan lokasi Anda di latar belakang saat Anda mengaktifkan Selalu.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Nova menggunakan lokasi Anda saat Anda mengizinkan berbagi lokasi.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Nova menggunakan mikrofon untuk obrolan realtime, voice wake, push-to-talk, dan pesan suara.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Nova dapat menggunakan data gerak untuk mendukung interaksi dan automasi yang sadar perangkat.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Nova membaca data langkah, tidur, detak jantung saat istirahat, dan olahraga Anda dari aplikasi Apple Health untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Nova tidak menulis data ke aplikasi Apple Health. Nova menggunakan data hanya-baca untuk membuat ringkasan yang Anda minta dan mengirimkannya melalui Gateway Anda ke penyedia AI yang dikonfigurasi.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Nova memungkinkan asisten Anda membaca foto yang Anda izinkan dan memungkinkan Anda memilih foto untuk dibagikan.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Nova menggunakan pengingat Anda untuk mencantumkan, menambahkan, dan menyelesaikan tugas saat Anda mengaktifkan akses pengingat.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Nova menggunakan pengenalan ucapan di perangkat untuk mode bicara dan bangun dengan suara.";
