"CFBundleDisplayName" = "$(NOVA_APP_DISPLAY_NAME)";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsFullAccessUsageDescription" = "Nova sử dụng lịch của bạn để hiển thị sự kiện và ngữ cảnh lên lịch khi bạn bật quyền truy cập lịch.";
/* Nova source: "Nova uses your calendars to show events and scheduling context when you enable calendar access." */
"NSCalendarsUsageDescription" = "Nova sử dụng lịch của bạn để hiển thị sự kiện và ngữ cảnh lên lịch khi bạn bật quyền truy cập lịch.";
/* Nova source: "Nova uses your calendars to add events when you enable calendar access." */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Nova sử dụng lịch của bạn để thêm sự kiện khi bạn bật quyền truy cập lịch.";
/* Nova source: "Nova uses the camera when you scan a Gateway setup QR code or ask your paired Gateway or assistant to capture a photo or short video from this iPhone, for example to connect to your Gateway or show your assistant a document, device screen, or workspace." */
"NSCameraUsageDescription" = "Nova sử dụng camera khi bạn quét mã QR thiết lập Gateway hoặc yêu cầu Gateway đã ghép đôi hay trợ lý của bạn chụp ảnh hoặc quay video ngắn từ iPhone này, ví dụ như để kết nối với Gateway của bạn hoặc hiển thị cho trợ lý một tài liệu, màn hình thiết bị hoặc không gian làm việc.";
/* Nova source: "Nova uses your contacts so you can search and reference people while using the assistant." */
"NSContactsUsageDescription" = "Nova sử dụng danh bạ của bạn để bạn có thể tìm kiếm và tham chiếu mọi người khi sử dụng trợ lý.";
/* Nova source: "Nova discovers and connects to your Nova gateway on the local network." */
"NSLocalNetworkUsageDescription" = "Nova phát hiện và kết nối với Nova gateway của bạn trên mạng cục bộ.";
/* Nova source: "Nova can share your location in the background when you enable Always." */
"NSLocationAlwaysAndWhenInUseUsageDescription" = "Nova có thể chia sẻ vị trí của bạn trong nền khi bạn bật Luôn luôn.";
/* Nova source: "Nova uses your location when you allow location sharing." */
"NSLocationWhenInUseUsageDescription" = "Nova sử dụng vị trí của bạn khi bạn cho phép chia sẻ vị trí.";
/* Nova source: "Nova uses the microphone for realtime chat, voice wake, push-to-talk, and voice notes." */
"NSMicrophoneUsageDescription" = "Nova sử dụng micrô cho trò chuyện thời gian thực, đánh thức bằng giọng nói, nhấn để nói và ghi chú thoại.";
/* Nova source: "Nova may use motion data to support device-aware interactions and automations." */
"NSMotionUsageDescription" = "Nova có thể sử dụng dữ liệu chuyển động để hỗ trợ các tương tác và tự động hóa nhận biết thiết bị.";
/* Nova source: "Nova reads your steps, sleep, resting heart rate, and workouts from the Apple Health app to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthShareUsageDescription" = "Nova đọc dữ liệu về số bước chân, giấc ngủ, nhịp tim khi nghỉ và hoạt động tập luyện của bạn từ ứng dụng Apple Health để tạo các bản tóm tắt mà bạn yêu cầu và gửi chúng thông qua Gateway đến nhà cung cấp AI mà bạn đã cấu hình.";
/* Nova source: "Nova does not write to the Apple Health app. It uses read-only data to create summaries you request and send them through your Gateway to your configured AI provider." */
"NSHealthUpdateUsageDescription" = "Nova không ghi dữ liệu vào ứng dụng Apple Health. Nova sử dụng dữ liệu chỉ đọc để tạo các bản tóm tắt mà bạn yêu cầu và gửi chúng thông qua Gateway đến nhà cung cấp AI mà bạn đã cấu hình.";
/* Nova source: "Nova lets your assistant read photos you allow and lets you choose photos to share." */
"NSPhotoLibraryUsageDescription" = "Nova cho phép trợ lý của bạn đọc những ảnh bạn cho phép và cho phép bạn chọn ảnh để chia sẻ.";
/* Nova source: "Nova uses your reminders to list, add, and complete tasks when you enable reminders access." */
"NSRemindersFullAccessUsageDescription" = "Nova sử dụng lời nhắc của bạn để liệt kê, thêm và hoàn tất tác vụ khi bạn bật quyền truy cập lời nhắc.";
/* Nova source: "Nova uses on-device speech recognition for talk mode and voice wake." */
"NSSpeechRecognitionUsageDescription" = "Nova sử dụng nhận dạng giọng nói trên thiết bị cho chế độ trò chuyện và đánh thức bằng giọng nói.";
