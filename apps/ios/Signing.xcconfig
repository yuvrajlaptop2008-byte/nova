// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "build/Version.xcconfig"

NOVA_CODE_SIGN_STYLE = Manual
NOVA_CODE_SIGN_IDENTITY = Apple Development
NOVA_CODE_SIGN_ENTITLEMENTS = Sources/Nova.entitlements
NOVA_DEVELOPMENT_TEAM = FWJYW4S8P8

NOVA_APP_BUNDLE_ID = ai.novafoundation.app
NOVA_SHARE_BUNDLE_ID = ai.novafoundation.app.share
NOVA_APP_GROUP_ID = group.ai.novafoundation.app.shared
NOVA_WATCH_APP_BUNDLE_ID = ai.novafoundation.app.watchkitapp
NOVA_ACTIVITY_WIDGET_BUNDLE_ID = ai.novafoundation.app.activitywidget
NOVA_APNS_ENTITLEMENT_ENVIRONMENT = development

NOVA_APP_PROFILE = ai.novafoundation.app Development
NOVA_SHARE_PROFILE = ai.novafoundation.app.share Development
NOVA_ACTIVITY_WIDGET_PROFILE =
NOVA_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
NOVA_DEBUG_APP_BUNDLE_ID = $(NOVA_APP_BUNDLE_ID).debug
NOVA_DEBUG_SHARE_BUNDLE_ID = $(NOVA_DEBUG_APP_BUNDLE_ID).share
NOVA_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(NOVA_DEBUG_APP_BUNDLE_ID).activitywidget
NOVA_DEBUG_WATCH_APP_BUNDLE_ID = $(NOVA_DEBUG_APP_BUNDLE_ID).watchkitapp
NOVA_DEBUG_APP_GROUP_ID = $(NOVA_APP_GROUP_ID).debug
